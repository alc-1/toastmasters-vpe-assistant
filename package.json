{
  "name": "toastmasters-vpe-assistant",
  "private": true,
  "license": "MIT",
  "version": "0.7.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "tsc --noEmit && wxt build --mode store",
    "build:firefox": "tsc --noEmit && wxt build -b firefox --mode store",
    "build:preview": "tsc --noEmit && wxt build --mode preview",
    "build:preview:firefox": "tsc --noEmit && wxt build -b firefox --mode preview",
    "zip": "wxt zip --mode store",
    "zip:firefox": "wxt zip -b firefox --mode store",
    "zip:preview": "wxt zip --mode preview",
    "zip:preview:firefox": "wxt zip -b firefox --mode preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
