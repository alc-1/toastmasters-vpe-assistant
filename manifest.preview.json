{
  "manifest_version": 3,
  "name": "Toastmasters VPE Assistant (Preview)",
  "version": "0.3.0",
  "description": "Get a clear view of your club’s progress by bringing EasySpeak and Basecamp data together in one place. Preview build for testers — not the Chrome Web Store version.",

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://basecamp.toastmasters.org/*",
    "https://apps.basecamp.toastmasters.org/*",
    "https://tmclub.eu/*",
    "https://toastmasterclub.org/*",
    "https://easy-speak.org/*"
  ],

  "background": {
    "service_worker": "background/index.ts",
    "type": "module"
  },

  "icons": {
    "16": "icons/default/16.png",
    "32": "icons/default/32.png",
    "48": "icons/default/48.png",
    "128": "icons/default/128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/default/16.png",
      "32": "icons/default/32.png",
      "48": "icons/default/48.png",
      "128": "icons/default/128.png"
    },
    "default_popup": "popup/index.html",
    "default_title": "Toastmasters VPE Assistant (Preview)"
  }
}
