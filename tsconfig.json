{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],

    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // WXT's own base tsconfig (extended above) turns this on by default;
    // overridden back off here to preserve this project's pre-existing
    // strictness level rather than surfacing a project-wide wave of
    // unrelated "possibly undefined" errors in code this migration didn't
    // otherwise touch.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests", "e2e", "scripts", "wxt.config.ts", "vitest.config.ts", "playwright.config.ts", ".wxt/wxt.d.ts"]
}
